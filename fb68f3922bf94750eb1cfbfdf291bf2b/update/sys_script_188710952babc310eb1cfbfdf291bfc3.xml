        <script><![CDATA[(function executeRule(current, previous) {

    var eventType = '';
	gs.info("Lifecycle callback BR triggered");
    if (current.state.getDisplayValue() == 'Resolved' || current.state.getDisplayValue() == 'Closed'){
		gs.info('Lifecycle callback incident resolved');
		new WrkfrcExpAMAlertUtils().sendITSMCallback(current, 'INCIDENT_RESOLVED');
    }
	
	else if (current.assigned_to.changes()){
		gs.info('Lifecycle callback incident assigned');
		new WrkfrcExpAMAlertUtils().sendITSMCallback(current, 'INCIDENT_ASSIGNED');
    }

	else if (current.operation() == 'update'){
		gs.info('Lifecycle callback incident updated');
		new WrkfrcExpAMAlertUtils().sendITSMCallback(current, 'INCIDENT_UPDATED');
	}
})(current, previous);]]></script>
