        <script_true><![CDATA[function onCondition() {

    // NEW RECORD → always editable
    if (g_form.isNewRecord()) {
        g_form.setReadOnly('active', false);
        return;
    }

    var ga = new GlideAjax('WrkfrcExpAMAlertUtils');
    ga.addParam('sysparm_name', 'isSingleRecord');

    ga.getXMLAnswer(function (response) {

        var isSingle = (response == 'true');

        g_form.setReadOnly('active', isSingle);

    });
}]]></script_true>
