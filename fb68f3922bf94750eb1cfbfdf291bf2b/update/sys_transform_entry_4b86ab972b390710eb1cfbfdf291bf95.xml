        <source_field>[Script]</source_field>
        <source_script><![CDATA[answer = (function transformEntry(source) {

    // Return the serial, not a sys_id. 'Referenced value field name' on this map is set to
    // serial_number, so the platform matches this value against cmdb_ci.serial_number itself.
    // Returning a sys_id instead makes the transformer fall back to display-value matching,
    // which silently drops any CI that has no name.
    var device = JSON.parse(source.u_devicedetails || '{}');
    return device.serialNumber || '';

})(source);]]></source_script>
